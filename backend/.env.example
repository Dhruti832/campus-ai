# Copy to .env and fill in. All of these have working defaults for local
# Docker Compose dev except the API keys — nothing here is required to run
# `docker compose up` as-is. See app/config.py for the source of truth.

# --- Database ---
# docker-compose default; point at Neon (or another Postgres+pgvector) for
# a live deploy. Must use the psycopg (v3) driver prefix.
DATABASE_URL=postgresql+psycopg://unichat:unichat@localhost:5432/unichat

# Which corpus config (backend/config/corpora/<name>.yaml) /chat serves by
# default. Can be overridden at runtime via the admin panel without a
# redeploy — see app/admin_service.py.
ACTIVE_CORPUS=example-docs

# --- LLM ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3
# Only needed if LLM_PROVIDER=groq. Get one free at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Admin panel (/admin/*) ---
# Empty = every admin route 403s. Set to a real random value to use the
# admin panel (see the frontend's /admin page for the matching UI).
ADMIN_API_KEY=

# --- Scheduled re-crawl (optional, off by default) ---
# See app/scheduler.py — not a reliable schedule on Render's free tier
# specifically, since the process sleeps after ~15 min idle.
SCHEDULED_INGEST_ENABLED=false
SCHEDULED_INGEST_INTERVAL_HOURS=24
